{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/User/{**catch-all}"
        }
      },
      "customer-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/Customer/{**catch-all}"
        }
      },
      "supplier-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/Supplier/{**catch-all}"
        }
      },
      "employee-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/Employee/{**catch-all}"
        }
      },
      "address-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/Address/{**catch-all}"
        }
      },

      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/Product/{**catch-all}"
        }
      },
      "brand-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/Brand/{**catch-all}"
        }
      },
      "category-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/Category/{**catch-all}"
        }
      },

      "stock-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/Stock/{**catch-all}"
        }
      },
      "warehouse-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/WhereHouse/{**catch-all}"
        }
      },

      "sales-order-route": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/SalesOrder/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://localhost:5146/"
          }
        }
      },

      "product-cluster": {
        "Destinations": {
          "product-service": {
            "Address": "http://localhost:5245/"
          }
        }
      },

      "inventory-cluster": {
        "Destinations": {
          "inventory-service": {
            "Address": "http://localhost:5091/"
          }
        }
      },

      "sales-cluster": {
        "Destinations": {
          "sales-service": {
            "Address": "http://localhost:5035/"
          }
        }
      }
    }
  }
}
